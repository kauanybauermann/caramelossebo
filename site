<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curadoria - Caramelos</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>

  <style>
    body { background-color: #f8f7f4; font-family: ui-sans-serif, system-ui, sans-serif; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row text-slate-800 p-4 gap-6">

  <aside class="w-full md:w-64 flex flex-col gap-2">
    <!-- Logotipo -->
    <div class="bg-white rounded-[2rem] p-6 shadow-sm flex items-center gap-3">
      <div class="w-10 h-10 bg-gradient-to-tr from-amber-200 to-orange-400 rounded-full shadow-inner flex items-center justify-center">
        <span class="text-white font-bold text-xl">C</span>
      </div>
      <h1 class="font-bold text-lg text-slate-700">Caramelos</h1>
    </div>

    <!-- NOVO: Contador de Livros -->
    <div class="bg-white rounded-[2rem] p-5 shadow-sm mb-2 flex flex-col gap-3">
      <div class="flex justify-between items-end">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Capacidade</span>
        <span class="text-sm font-bold text-slate-700" id="contador-texto">0 / 10000</span>
      </div>
      <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
        <div id="contador-barra" class="bg-gradient-to-r from-orange-400 to-amber-300 h-full rounded-full transition-all duration-1000" style="width: 0%"></div>
      </div>
    </div>

    <!-- Navegação -->
    <nav class="flex flex-col gap-2 bg-white p-4 rounded-[2rem] shadow-sm" id="menu-abas">
      <button onclick="mudarAba('todas')" class="aba-btn text-left px-5 py-3 rounded-full font-medium transition-all bg-gradient-to-r from-orange-100 to-amber-50 text-orange-700 shadow-sm" data-id="todas">Todas as Curadorias</button>
      <button onclick="mudarAba('a_fazer')" class="aba-btn text-left px-5 py-3 rounded-full font-medium transition-all text-slate-500 hover:bg-slate-50 hover:text-slate-700" data-id="a_fazer">A Fazer</button>
      <button onclick="mudarAba('com_valor_final')" class="aba-btn text-left px-5 py-3 rounded-full font-medium transition-all text-slate-500 hover:bg-slate-50 hover:text-slate-700" data-id="com_valor_final">Com Valor Final</button>
      <button onclick="mudarAba('falta_valor_final')" class="aba-btn text-left px-5 py-3 rounded-full font-medium transition-all text-slate-500 hover:bg-slate-50 hover:text-slate-700" data-id="falta_valor_final">Falta Valor Final</button>
    </nav>
  </aside>

  <main class="flex-1 flex flex-col gap-6">
    <div class="flex flex-col xl:flex-row gap-4 justify-between items-center bg-white p-4 rounded-full shadow-sm px-6">
      <div class="flex w-full xl:w-auto items-center gap-4">
        <div class="relative w-full xl:w-80">
          <i data-lucide="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="busca-texto" placeholder="Buscar livros..." oninput="renderizarLivros()" class="w-full bg-[#f8f7f4] border-none rounded-full py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-orange-200 outline-none">
        </div>
        <div class="relative flex items-center">
          <input type="date" id="busca-data" onchange="renderizarLivros()" class="bg-[#f8f7f4] border-none rounded-full py-3 px-4 text-sm focus:ring-2 focus:ring-orange-200 outline-none text-slate-600 cursor-pointer">
          <button onclick="limparData()" class="absolute right-3 text-slate-400 hover:text-rose-500 hidden" id="btn-limpar-data"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        
        <button id="btn-ordem" onclick="alternarOrdem()" class="flex items-center gap-2 bg-[#f8f7f4] px-4 py-3 rounded-full text-sm font-medium text-slate-600 hover:bg-[#f0eee9] transition-colors" title="Ordem A-Z">
          <i data-lucide="arrow-down-a-z" class="w-4 h-4"></i>
        </button>
        
      </div>
      <button onclick="abrirModal()" class="w-full xl:w-auto bg-gradient-to-r from-purple-500 via-rose-400 to-orange-400 text-white px-8 py-3 rounded-full font-bold shadow-md hover:opacity-90 transition-opacity flex items-center justify-center gap-2">
        <i data-lucide="plus" class="w-5 h-5"></i> Nova Curadoria
      </button>
    </div>

    <div id="grid-livros" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6"></div>
  </main>

  <div id="modal-imagem" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-[60] flex items-center justify-center p-4 cursor-pointer hidden" onclick="fecharImagem()">
    <button class="absolute top-6 right-6 text-white bg-slate-800/50 p-2 rounded-full hover:bg-rose-500 transition-colors">
      <i data-lucide="x" class="w-8 h-8"></i>
    </button>
    <img id="img-ampliada" src="" alt="Capa Ampliada" class="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-2xl cursor-default" onclick="event.stopPropagation()">
  </div>

  <div id="modal-form" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-end hidden">
    <div class="bg-[#fcfbf9] w-full md:w-[500px] h-full shadow-2xl flex flex-col relative">
      <div class="p-6 border-b border-[#f0eee9] flex justify-between items-center bg-white">
        <h2 id="modal-titulo" class="text-xl font-bold text-slate-800">Nova Curadoria</h2>
        <button onclick="fecharModal()" class="p-2 text-slate-400 hover:bg-slate-100 rounded-full">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="form-livro" onsubmit="salvarLivro(event)" class="p-6 overflow-y-auto flex-1 space-y-5">
        <input type="hidden" id="form-id">
        <input type="hidden" id="form-postado" value="false">
        
        <div class="flex gap-4 items-end">
          <div class="w-32 h-40 bg-white border-2 border-dashed border-slate-200 rounded-2xl flex flex-col items-center justify-center overflow-hidden relative group">
            <img id="form-preview-img" src="" class="w-full h-full object-cover hidden">
            <div id="form-placeholder-img" class="text-center p-2 text-slate-400">
              <i data-lucide="image" class="w-8 h-8 mx-auto mb-1 opacity-50"></i>
              <span class="text-[10px] font-medium">Add Foto</span>
            </div>
            <input type="file" id="form-imagem-upload" accept="image/*" onchange="carregarImagem(event)" class="absolute inset-0 opacity-0 cursor-pointer">
            <input type="hidden" id="form-imagem-base64">
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Título</label>
              <input required type="text" id="form-titulo" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Autor</label>
              <input required type="text" id="form-autor" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm">
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Capa</label>
            <select id="form-capa" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm">
              <option>Brochura</option><option>Capa Dura</option><option>Espiral</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Estado</label>
            <input type="text" id="form-estado" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm">
          </div>
          <div>
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Valor Sugerido</label>
            <input type="text" id="form-valorSugerido" placeholder="R$ 0,00" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm">
          </div>
          <div>
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Valor Final</label>
            <input type="text" id="form-valorFinal" placeholder="R$ 0,00" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Data Curadoria</label>
            <input type="date" id="form-dataCuradoria" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm text-slate-600">
          </div>
          <div>
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">Status</label>
            <select id="form-status" class="w-full mt-1 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm font-medium">
              <option value="a_fazer">A Fazer</option>
              <option value="com_valor_final">Com Valor Final</option>
              <option value="falta_valor_final">Falta Valor Final</option>
            </select>
          </div>
        </div>

        <div>
          <label class="text-xs font-bold text-slate-500 uppercase tracking-wider ml-1 flex items-center justify-between">Rascunho de Postagem</label>
          <textarea id="form-textoPostagem" rows="4" placeholder="Escreva aqui o texto que será usado para divulgar o livro..." class="w-full mt-2 bg-white border border-slate-200 rounded-2xl p-4 focus:outline-none focus:ring-2 focus:ring-orange-200 text-sm resize-none"></textarea>
        </div>

        <button id="btn-salvar" type="submit" class="w-full bg-slate-800 text-white py-4 rounded-full font-bold hover:bg-slate-700 transition-colors mt-4">
          Salvar Curadoria
        </button>
      </form>
    </div>
  </div>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyBP-L894w1jPvDVqnOesqfx4rklNqRJpJo",
      authDomain: "sebo-caramelos.firebaseapp.com",
      projectId: "sebo-caramelos",
      storageBucket: "sebo-caramelos.firebasestorage.app",
      messagingSenderId: "746285334645",
      appId: "1:746285334645:web:e72762a2f44c752d6f383c",
      measurementId: "G-Y4VK0CVKPN"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    let livrosGlobais = [];
    let abaAtiva = 'todas';
    let ordenacao = 'a_z';

    document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        document.getElementById('form-dataCuradoria').value = new Date().toISOString().split('T')[0];
        
        db.collection("livros").onSnapshot((snapshot) => {
            livrosGlobais = [];
            snapshot.forEach((doc) => {
                livrosGlobais.push({ id: doc.id, ...doc.data() });
            });
            atualizarContador();
            renderizarLivros();
        });
    });

    // NOVO: Função para atualizar o contador de livros
    function atualizarContador() {
        const total = livrosGlobais.length;
        const max = 10000;
        let porcentagem = (total / max) * 100;
        
        // Garante que a barra não passe de 100%
        if(porcentagem > 100) porcentagem = 100;

        document.getElementById('contador-texto').innerText = `${total} / ${max}`;
        document.getElementById('contador-barra').style.width = `${porcentagem}%`;
    }

    function mudarAba(aba) {
        abaAtiva = aba;
        document.getElementById('busca-data').value = '';
        document.querySelectorAll('.aba-btn').forEach(btn => {
            if(btn.dataset.id === aba) {
                btn.className = "aba-btn text-left px-5 py-3 rounded-full font-medium transition-all bg-gradient-to-r from-orange-100 to-amber-50 text-orange-700 shadow-sm";
            } else {
                btn.className = "aba-btn text-left px-5 py-3 rounded-full font-medium transition-all text-slate-500 hover:bg-slate-50 hover:text-slate-700";
            }
        });
        renderizarLivros();
    }

    function alternarOrdem() {
        ordenacao = ordenacao === 'a_z' ? 'z_a' : 'a_z';
        const btn = document.getElementById('btn-ordem');
        
        if(ordenacao === 'a_z') {
            btn.innerHTML = `<i data-lucide="arrow-down-a-z" class="w-4 h-4"></i>`;
            btn.title = "Ordem A-Z";
        } else {
            btn.innerHTML = `<i data-lucide="arrow-up-a-z" class="w-4 h-4"></i>`;
            btn.title = "Ordem Z-A";
        }
        
        lucide.createIcons();
        renderizarLivros();
    }

    function limparData() {
        document.getElementById('busca-data').value = '';
        renderizarLivros();
    }

    function editarLivro(id) {
        abrirModal(id);
    }

    function abrirModal(id = null) {
        document.getElementById('modal-form').classList.remove('hidden');
        if (id) {
            const livro = livrosGlobais.find(l => String(l.id) === String(id));
            if(!livro) return;
            document.getElementById('modal-titulo').innerText = 'Editar Curadoria';
            document.getElementById('form-id').value = livro.id;
            document.getElementById('form-titulo').value = livro.titulo;
            document.getElementById('form-autor').value = livro.autor;
            document.getElementById('form-capa').value = livro.capa;
            document.getElementById('form-estado').value = livro.estado;
            document.getElementById('form-valorSugerido').value = livro.valorSugerido;
            document.getElementById('form-valorFinal').value = livro.valorFinal;
            document.getElementById('form-dataCuradoria').value = livro.dataCuradoria;
            document.getElementById('form-status').value = livro.status;
            document.getElementById('form-textoPostagem').value = livro.textoPostagem || '';
            document.getElementById('form-postado').value = livro.postado;
            document.getElementById('form-imagem-base64').value = livro.imagem || '';
            
            if(livro.imagem) {
                document.getElementById('form-preview-img').src = livro.imagem;
                document.getElementById('form-preview-img').classList.remove('hidden');
                document.getElementById('form-placeholder-img').classList.add('hidden');
            } else {
                document.getElementById('form-preview-img').src = '';
                document.getElementById('form-preview-img').classList.add('hidden');
                document.getElementById('form-placeholder-img').classList.remove('hidden');
            }
        } else {
            document.getElementById('form-livro').reset();
            document.getElementById('modal-titulo').innerText = 'Nova Curadoria';
            document.getElementById('form-id').value = '';
            document.getElementById('form-imagem-base64').value = '';
            document.getElementById('form-postado').value = 'false';
            document.getElementById('form-preview-img').classList.add('hidden');
            document.getElementById('form-placeholder-img').classList.remove('hidden');
            document.getElementById('form-dataCuradoria').value = new Date().toISOString().split('T')[0];
        }
    }

    function fecharModal() {
        document.getElementById('modal-form').classList.add('hidden');
    }

    function carregarImagem(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 800;
                    const MAX_HEIGHT = 800;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                    } else {
                        if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    const dataUrl = canvas.toDataURL('image/jpeg', 0.6);

                    document.getElementById('form-imagem-base64').value = dataUrl;
                    document.getElementById('form-preview-img').src = dataUrl;
                    document.getElementById('form-preview-img').classList.remove('hidden');
                    document.getElementById('form-placeholder-img').classList.add('hidden');
                };
                img.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    }

    async function salvarLivro(event) {
        event.preventDefault();
        
        const btnSalvar = document.getElementById('btn-salvar');
        btnSalvar.innerText = 'A guardar...';
        btnSalvar.disabled = true;

        const id = document.getElementById('form-id').value;
        const titulo = document.getElementById('form-titulo').value.trim();
        
        const livroDuplicado = livrosGlobais.some(l => l.titulo.toLowerCase() === titulo.toLowerCase() && String(l.id) !== String(id));
        if (livroDuplicado) {
            alert("ATENÇÃO: Este livro já passou por curadoria e está no sistema. Não processe títulos repetidos.");
            btnSalvar.innerText = 'Salvar Curadoria';
            btnSalvar.disabled = false;
            return;
        }

        const dadosLivro = {
            titulo: titulo,
            autor: document.getElementById('form-autor').value,
            capa: document.getElementById('form-capa').value,
            estado: document.getElementById('form-estado').value,
            valorSugerido: document.getElementById('form-valorSugerido').value,
            valorFinal: document.getElementById('form-valorFinal').value,
            dataCuradoria: document.getElementById('form-dataCuradoria').value,
            status: document.getElementById('form-status').value,
            textoPostagem: document.getElementById('form-textoPostagem').value,
            postado: document.getElementById('form-postado').value === 'true',
            imagem: document.getElementById('form-imagem-base64').value
        };

        try {
            if (id) {
                await db.collection("livros").doc(id).update(dadosLivro);
            } else {
                dadosLivro.timestampCriacao = Date.now();
                await db.collection("livros").add(dadosLivro);
            }
            fecharModal();
        } catch (error) {
            console.error("Erro ao guardar: ", error);
            alert("Erro ao guardar. Verifique se o Firebase está bem configurado.");
        } finally {
            btnSalvar.innerText = 'Salvar Curadoria';
            btnSalvar.disabled = false;
        }
    }

    async function excluirLivro(id) {
        if(confirm("Tem a certeza que deseja remover esta curadoria? Ela será apagada para toda a equipa!")) {
            try {
                await db.collection("livros").doc(id).delete();
            } catch (error) {
                console.error("Erro ao apagar: ", error);
            }
        }
    }

    async function alternarPostado(id) {
        const livro = livrosGlobais.find(l => String(l.id) === String(id));
        if(livro) {
            try {
                await db.collection("livros").doc(id).update({ postado: !livro.postado });
            } catch (error) {
                console.error("Erro ao atualizar postagem: ", error);
            }
        }
    }

    function copiarTexto(id) {
        const livro = livrosGlobais.find(l => String(l.id) === String(id));
        if(livro && livro.textoPostagem && livro.textoPostagem.trim() !== '') {
            navigator.clipboard.writeText(livro.textoPostagem)
                .then(() => alert("Rascunho copiado para a área de transferência!"))
                .catch(() => alert("Erro ao copiar o texto."));
        } else {
            alert("Este livro não possui rascunho de postagem para copiar.");
        }
    }

    function abrirImagem(base64) {
        if(!base64) return;
        document.getElementById('img-ampliada').src = base64;
        document.getElementById('modal-imagem').classList.remove('hidden');
    }

    function fecharImagem() {
        document.getElementById('modal-imagem').classList.add('hidden');
    }

    function renderizarLivros() {
        const grid = document.getElementById('grid-livros');
        const buscaTexto = document.getElementById('busca-texto').value.toLowerCase();
        const buscaData = document.getElementById('busca-data').value;
        
        document.getElementById('btn-limpar-data').classList.toggle('hidden', buscaData === '');

        let filtrados = livrosGlobais.filter(livro => {
            const matchBusca = livro.titulo.toLowerCase().includes(buscaTexto) || livro.autor.toLowerCase().includes(buscaTexto);
            const matchAba = abaAtiva === 'todas' || livro.status === abaAtiva;
            const matchData = buscaData === '' || livro.dataCuradoria === buscaData;
            return matchBusca && matchAba && matchData;
        });

        filtrados.sort((a, b) => {
            if (ordenacao === 'a_z') {
                return a.titulo.localeCompare(b.titulo);
            } else {
                return b.titulo.localeCompare(a.titulo);
            }
        });

        if (filtrados.length === 0) {
            grid.innerHTML = `<div class="col-span-full text-center py-20 text-slate-400"><p>Nenhum livro encontrado com estes filtros.</p></div>`;
            return;
        }

        let html = '';
        filtrados.forEach(livro => {
            let statusCor = livro.status === 'a_fazer' ? 'text-orange-500 bg-orange-50 border-orange-100' : livro.status === 'com_valor_final' ? 'text-emerald-600 bg-emerald-50 border-emerald-100' : 'text-rose-500 bg-rose-50 border-rose-100';
            let statusLabel = livro.status === 'a_fazer' ? 'A FAZER' : livro.status === 'com_valor_final' ? 'COM VALOR FINAL' : 'FALTA VALOR FINAL';
            const dataFormatada = livro.dataCuradoria.split('-').reverse().join('/');
            const btnPostadoClass = livro.postado ? 'bg-indigo-50 border-indigo-200 text-indigo-600' : 'bg-white border-slate-200 text-slate-500 hover:bg-slate-50';
            const iconePostado = livro.postado ? 'check-square' : 'square';
            const imagemHtml = livro.imagem ? `<img src="${livro.imagem}" class="w-full h-full object-cover" />` : `<i data-lucide="image" class="w-8 h-8 text-slate-300"></i>`;

            html += `
            <div class="bg-white rounded-[2rem] p-5 shadow-sm border border-transparent hover:border-orange-100 transition-all flex flex-col gap-5 relative group">
                <div class="flex gap-4 items-start">
                  <div onclick="abrirImagem('${livro.imagem || ''}')" class="w-24 h-32 bg-[#f8f7f4] rounded-2xl overflow-hidden flex-shrink-0 cursor-pointer border border-slate-100 flex items-center justify-center shadow-sm hover:opacity-80 transition-opacity">
                    ${imagemHtml}
                  </div>
                  <div class="flex flex-col items-start gap-2 pt-1">
                    <h3 class="font-bold text-slate-800 leading-tight text-lg max-w-[160px] truncate" title="${livro.titulo}">${livro.titulo}</h3>
                    <p class="text-slate-500 text-sm font-medium">${livro.autor}</p>
                    <div class="flex flex-col items-start gap-1.5 mt-1">
                      <span class="text-[10px] font-bold px-3 py-1 rounded-full border ${statusCor}">${statusLabel}</span>
                      <span class="text-[11px] font-medium px-3 py-1 bg-[#f5f5f0] text-slate-500 rounded-full">${dataFormatada}</span>
                    </div>
                  </div>
                </div>
                <div class="bg-[#fcfbf9] rounded-[1.5rem] p-4 flex justify-between border border-[#f0eee9]">
                  <div class="flex flex-col gap-1 text-sm text-slate-600 justify-center">
                    <p><span class="font-semibold text-slate-400">Capa:</span> ${livro.capa}</p>
                    <p><span class="font-semibold text-slate-400">Estado:</span> ${livro.estado}</p>
                  </div>
                  <div class="w-px bg-slate-200 mx-2"></div>
                  <div class="flex flex-col gap-2 text-right justify-center min-w-[100px]">
                    <div>
                      <p class="text-[10px] font-bold text-indigo-400 uppercase tracking-wide">Valor Sugerido</p>
                      <p class="font-bold text-slate-700">${livro.valorSugerido || '-'}</p>
                    </div>
                    <div>
                      <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-wide">Valor Final</p>
                      <p class="font-bold text-slate-700">${livro.valorFinal || '-'}</p>
                    </div>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button onclick="alternarPostado('${livro.id}')" class="flex items-center gap-2 px-4 py-2.5 rounded-full border transition-all ${btnPostadoClass}">
                    <i data-lucide="${iconePostado}" class="w-5 h-5"></i>
                    <span class="text-xs font-bold tracking-wide">MARCAR POSTADO</span>
                  </button>
                  <div class="flex items-center gap-2">
                    <button onclick="copiarTexto('${livro.id}')" class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:text-indigo-500 hover:border-indigo-200 transition-colors bg-white"><i data-lucide="copy" class="w-4 h-4"></i></button>
                    <button onclick="editarLivro('${livro.id}')" class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:text-amber-500 hover:border-amber-200 transition-colors bg-white"><i data-lucide="edit-2" class="w-4 h-4"></i></button>
                    <button onclick="excluirLivro('${livro.id}')" class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:border-rose-200 transition-colors bg-white"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                  </div>
                </div>
            </div>`;
        });
        grid.innerHTML = html;
        lucide.createIcons();
    }
  </script>
</body>
</html>
